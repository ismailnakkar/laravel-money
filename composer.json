{
    "name": "ismailnakkar/laravel-money",
    "description": "Money as an exact decimal string in Laravel: check it, cut it, print it. No floats, down to nine decimals.",
    "keywords": [
        "laravel",
        "money",
        "decimal",
        "bcmath",
        "validation"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-money",
    "license": "MIT",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ismailnakkar/laravel-money/issues"
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5.8 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "ExactMoney\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExactMoney\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExactMoney\\MoneyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@lint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
